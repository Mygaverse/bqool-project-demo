{
  "global": {
    "color": {
      "brand": {
        "500": {
          "$type": "color",
          "$value": "#4aaada"
        },
        "600": {
          "$type": "color",
          "$value": "#3a9aca"
        },
        "800": {
          "$type": "color",
          "$value": "#0066b7"
        }
      },
      "tint": {
        "brand": {
          "$type": "color",
          "$value": "#f1f7ff"
        }
      },
      "grey": {
        "50": {
          "$type": "color",
          "$value": "#f7f9fb"
        },
        "100": {
          "$type": "color",
          "$value": "#fafafa"
        },
        "200": {
          "$type": "color",
          "$value": "#e2e2e2"
        },
        "400": {
          "$type": "color",
          "$value": "#b2b2b2"
        },
        "500": {
          "$type": "color",
          "$value": "#5a6b7a"
        },
        "900": {
          "$type": "color",
          "$value": "#212529"
        }
      },
      "success": {
        "500": {
          "$type": "color",
          "$value": "#76b548"
        }
      },
      "warning": {
        "500": {
          "$type": "color",
          "$value": "#ffc107"
        }
      },
      "danger": {
        "500": {
          "$type": "color",
          "$value": "#fd625e"
        }
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "overlay": {
        "shadow-10": {
          "$type": "color",
          "$value": "rgba(33, 37, 41, 0.1)"
        },
        "shadow-15": {
          "$type": "color",
          "$value": "rgba(33, 37, 41, 0.15)"
        },
        "success-20": {
          "$type": "color",
          "$value": "rgba(118, 181, 72, 0.2)"
        },
        "warning-20": {
          "$type": "color",
          "$value": "rgba(255, 193, 7, 0.2)"
        },
        "danger-20": {
          "$type": "color",
          "$value": "rgba(253, 98, 94, 0.2)"
        },
        "muted-40": {
          "$type": "color",
          "$value": "rgba(178, 178, 178, 0.4)"
        },
        "ink-40": {
          "$type": "color",
          "$value": "rgba(33, 37, 41, 0.4)"
        }
      }
    },
    "space": {
      "1": {
        "$type": "spacing",
        "$value": "4"
      },
      "2": {
        "$type": "spacing",
        "$value": "8"
      },
      "3": {
        "$type": "spacing",
        "$value": "12"
      },
      "4": {
        "$type": "spacing",
        "$value": "16"
      },
      "5": {
        "$type": "spacing",
        "$value": "20"
      },
      "6": {
        "$type": "spacing",
        "$value": "24"
      },
      "7": {
        "$type": "spacing",
        "$value": "28"
      },
      "8": {
        "$type": "spacing",
        "$value": "32"
      }
    },
    "radius": {
      "sm": {
        "$type": "borderRadius",
        "$value": "4"
      },
      "md": {
        "$type": "borderRadius",
        "$value": "8"
      },
      "lg": {
        "$type": "borderRadius",
        "$value": "10"
      },
      "full": {
        "$type": "borderRadius",
        "$value": "999"
      }
    },
    "fontFamily": {
      "sans": {
        "$type": "fontFamilies",
        "$value": "Nokora"
      }
    },
    "fontSize": {
      "xxs": {
        "$type": "fontSizes",
        "$value": "10"
      },
      "xs": {
        "$type": "fontSizes",
        "$value": "12"
      },
      "sm": {
        "$type": "fontSizes",
        "$value": "14"
      },
      "base": {
        "$type": "fontSizes",
        "$value": "16"
      },
      "lg": {
        "$type": "fontSizes",
        "$value": "18"
      },
      "xl": {
        "$type": "fontSizes",
        "$value": "20"
      },
      "2xl": {
        "$type": "fontSizes",
        "$value": "24"
      },
      "3xl": {
        "$type": "fontSizes",
        "$value": "30"
      },
      "4xl": {
        "$type": "fontSizes",
        "$value": "36"
      }
    },
    "fontWeight": {
      "light": {
        "$type": "fontWeights",
        "$value": "300"
      },
      "regular": {
        "$type": "fontWeights",
        "$value": "400"
      },
      "medium": {
        "$type": "fontWeights",
        "$value": "500"
      },
      "semibold": {
        "$type": "fontWeights",
        "$value": "600"
      },
      "bold": {
        "$type": "fontWeights",
        "$value": "700"
      }
    },
    "shadow": {
      "sm": {
        "$type": "boxShadow",
        "$value": {
          "color": "{color.overlay.shadow-10}",
          "type": "dropShadow",
          "x": "0",
          "y": "1",
          "blur": "2",
          "spread": "0"
        }
      },
      "md": {
        "$type": "boxShadow",
        "$value": {
          "color": "{color.overlay.shadow-15}",
          "type": "dropShadow",
          "x": "0",
          "y": "4",
          "blur": "12",
          "spread": "0"
        }
      }
    }
  },
  "semantic": {
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.grey.900}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.grey.500}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "brand": {
        "$type": "color",
        "$value": "{color.brand.500}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.overlay.ink-40}"
      }
    },
    "surface": {
      "default": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.grey.50}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.grey.100}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.grey.400}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.grey.200}"
      },
      "selected": {
        "$type": "color",
        "$value": "{color.tint.brand}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.overlay.muted-40}"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{color.brand.500}"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{color.brand.600}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "secondary-hover": {
        "$type": "color",
        "$value": "{color.tint.brand}"
      },
      "theme": {
        "$type": "color",
        "$value": "{color.brand.800}"
      }
    },
    "feedback": {
      "success": {
        "$type": "color",
        "$value": "{color.success.500}"
      },
      "warning": {
        "$type": "color",
        "$value": "{color.warning.500}"
      },
      "danger": {
        "$type": "color",
        "$value": "{color.danger.500}"
      }
    },
    "typography": {
      "heading-lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.bold}",
          "fontSize": "{fontSize.3xl}",
          "lineHeight": "36px"
        }
      },
      "heading-md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.semibold}",
          "fontSize": "{fontSize.xl}",
          "lineHeight": "24px"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.regular}",
          "fontSize": "{fontSize.base}",
          "lineHeight": "24px"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.regular}",
          "fontSize": "{fontSize.xs}",
          "lineHeight": "18px"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.semibold}",
          "fontSize": "{fontSize.xs}",
          "lineHeight": "18px"
        }
      },
      "body-sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontWeight": "{fontWeight.medium}",
          "fontSize": "{fontSize.sm}",
          "lineHeight": "20px"
        }
      }
    },
    "elevation": {
      "resting": {
        "$type": "boxShadow",
        "$value": "{shadow.sm}"
      },
      "raised": {
        "$type": "boxShadow",
        "$value": "{shadow.md}"
      }
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": {
          "$type": "color",
          "$value": "{action.primary}"
        },
        "bg-hover": {
          "$type": "color",
          "$value": "{action.primary-hover}"
        },
        "fg": {
          "$type": "color",
          "$value": "{text.inverse}"
        },
        "radius": {
          "$type": "borderRadius",
          "$value": "{radius.md}"
        },
        "bg-disabled": {
          "$type": "color",
          "$value": "{surface.disabled}"
        },
        "fg-disabled": {
          "$type": "color",
          "$value": "{text.disabled}"
        }
      },
      "secondary": {
        "bg": {
          "$type": "color",
          "$value": "{surface.default}"
        },
        "bg-hover": {
          "$type": "color",
          "$value": "{action.primary}"
        },
        "fg": {
          "$type": "color",
          "$value": "{text.primary}"
        },
        "fg-hover": {
          "$type": "color",
          "$value": "{text.inverse}"
        },
        "border": {
          "$type": "color",
          "$value": "{surface.border}"
        },
        "border-hover": {
          "$type": "color",
          "$value": "{action.primary}"
        },
        "bg-disabled": {
          "$type": "color",
          "$value": "{surface.disabled}"
        },
        "fg-disabled": {
          "$type": "color",
          "$value": "{text.disabled}"
        }
      }
    },
    "badge": {
      "outline": {
        "neutral": {
          "bg": {
            "$type": "color",
            "$value": "{surface.default}"
          },
          "border": {
            "$type": "color",
            "$value": "{surface.border}"
          },
          "fg": {
            "$type": "color",
            "$value": "{text.secondary}"
          }
        },
        "success": {
          "bg": {
            "$type": "color",
            "$value": "{surface.default}"
          },
          "border": {
            "$type": "color",
            "$value": "{feedback.success}"
          },
          "fg": {
            "$type": "color",
            "$value": "{feedback.success}"
          }
        },
        "warning": {
          "bg": {
            "$type": "color",
            "$value": "{surface.default}"
          },
          "border": {
            "$type": "color",
            "$value": "{feedback.warning}"
          },
          "fg": {
            "$type": "color",
            "$value": "{feedback.warning}"
          }
        },
        "danger": {
          "bg": {
            "$type": "color",
            "$value": "{surface.default}"
          },
          "border": {
            "$type": "color",
            "$value": "{feedback.danger}"
          },
          "fg": {
            "$type": "color",
            "$value": "{feedback.danger}"
          }
        }
      },
      "solid": {
        "neutral": {
          "bg": {
            "$type": "color",
            "$value": "{text.secondary}"
          },
          "fg": {
            "$type": "color",
            "$value": "{text.inverse}"
          }
        },
        "success": {
          "bg": {
            "$type": "color",
            "$value": "{color.overlay.success-20}"
          },
          "fg": {
            "$type": "color",
            "$value": "{feedback.success}"
          }
        },
        "warning": {
          "bg": {
            "$type": "color",
            "$value": "{color.overlay.warning-20}"
          },
          "fg": {
            "$type": "color",
            "$value": "{feedback.warning}"
          }
        },
        "danger": {
          "bg": {
            "$type": "color",
            "$value": "{color.overlay.danger-20}"
          },
          "fg": {
            "$type": "color",
            "$value": "{feedback.danger}"
          }
        }
      }
    },
    "toggle": {
      "track-on": {
        "$type": "color",
        "$value": "{action.primary}"
      },
      "track-off": {
        "$type": "color",
        "$value": "{surface.border}"
      },
      "knob": {
        "$type": "color",
        "$value": "{color.white}"
      }
    },
    "card": {
      "bg": {
        "$type": "color",
        "$value": "{surface.default}"
      },
      "border": {
        "$type": "color",
        "$value": "{surface.border}"
      },
      "radius": {
        "$type": "borderRadius",
        "$value": "{radius.lg}"
      },
      "shadow": {
        "$type": "boxShadow",
        "$value": "{elevation.resting}"
      },
      "selected": {
        "bg": {
          "$type": "color",
          "$value": "{surface.selected}"
        },
        "border": {
          "$type": "color",
          "$value": "{action.primary}"
        }
      }
    },
    "trendPill": {
      "positive": {
        "bg": {
          "$type": "color",
          "$value": "{color.overlay.success-20}"
        },
        "fg": {
          "$type": "color",
          "$value": "{feedback.success}"
        }
      },
      "negative": {
        "bg": {
          "$type": "color",
          "$value": "{color.overlay.danger-20}"
        },
        "fg": {
          "$type": "color",
          "$value": "{feedback.danger}"
        }
      }
    },
    "deliveryStatus": {
      "delivering": {
        "$type": "color",
        "$value": "{feedback.success}"
      },
      "limited": {
        "$type": "color",
        "$value": "{feedback.warning}"
      },
      "not-delivering": {
        "$type": "color",
        "$value": "{feedback.danger}"
      }
    },
    "statusPill": {
      "enabled": {
        "bg": {
          "$type": "color",
          "$value": "{action.primary}"
        },
        "fg": {
          "$type": "color",
          "$value": "{text.inverse}"
        }
      },
      "paused": {
        "bg": {
          "$type": "color",
          "$value": "{surface.muted}"
        },
        "fg": {
          "$type": "color",
          "$value": "{text.inverse}"
        }
      },
      "pending": {
        "bg": {
          "$type": "color",
          "$value": "{surface.default}"
        },
        "fg": {
          "$type": "color",
          "$value": "{action.primary}"
        },
        "border": {
          "$type": "color",
          "$value": "{action.primary}"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "bqool-default",
      "name": "Default",
      "selectedTokenSets": {
        "global": "source",
        "semantic": "enabled",
        "component": "enabled"
      }
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "global",
      "semantic",
      "component"
    ]
  }
}