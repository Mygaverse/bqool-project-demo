{
  "color": {
    "brand": {
      "500": { "$type": "color", "$value": "#4aaada" },
      "600": { "$type": "color", "$value": "#3a9aca" },
      "800": { "$type": "color", "$value": "#0066b7" }
    },
    "tint": {
      "brand": { "$type": "color", "$value": "#f1f7ff" }
    },
    "grey": {
      "50": { "$type": "color", "$value": "#f7f9fb" },
      "200": { "$type": "color", "$value": "#e2e2e2" },
      "400": { "$type": "color", "$value": "#b2b2b2" },
      "500": { "$type": "color", "$value": "#5a6b7a" },
      "900": { "$type": "color", "$value": "#212529" }
    },
    "success": {
      "500": { "$type": "color", "$value": "#76b548" }
    },
    "warning": {
      "500": { "$type": "color", "$value": "#ffc107" }
    },
    "danger": {
      "500": { "$type": "color", "$value": "#fd625e" }
    },
    "white": { "$type": "color", "$value": "#ffffff" },
    "overlay": {
      "shadow-10": { "$type": "color", "$value": "rgba(33, 37, 41, 0.1)" },
      "shadow-15": { "$type": "color", "$value": "rgba(33, 37, 41, 0.15)" },
      "success-20": { "$type": "color", "$value": "rgba(118, 181, 72, 0.2)" },
      "warning-20": { "$type": "color", "$value": "rgba(255, 193, 7, 0.2)" },
      "danger-20": { "$type": "color", "$value": "rgba(253, 98, 94, 0.2)" },
      "muted-40": { "$type": "color", "$value": "rgba(178, 178, 178, 0.4)" },
      "ink-40": { "$type": "color", "$value": "rgba(33, 37, 41, 0.4)" }
    }
  },
  "space": {
    "1": { "$type": "spacing", "$value": "4" },
    "2": { "$type": "spacing", "$value": "8" },
    "3": { "$type": "spacing", "$value": "12" },
    "4": { "$type": "spacing", "$value": "16" },
    "6": { "$type": "spacing", "$value": "24" },
    "8": { "$type": "spacing", "$value": "32" }
  },
  "radius": {
    "sm": { "$type": "borderRadius", "$value": "4" },
    "md": { "$type": "borderRadius", "$value": "8" },
    "lg": { "$type": "borderRadius", "$value": "10" },
    "full": { "$type": "borderRadius", "$value": "999" }
  },
  "fontFamily": {
    "sans": { "$type": "fontFamilies", "$value": "Nokora" }
  },
  "fontSize": {
    "xxs": { "$type": "fontSizes", "$value": "10" },
    "xs": { "$type": "fontSizes", "$value": "12" },
    "sm": { "$type": "fontSizes", "$value": "14" },
    "base": { "$type": "fontSizes", "$value": "16" },
    "lg": { "$type": "fontSizes", "$value": "18" },
    "xl": { "$type": "fontSizes", "$value": "20" },
    "2xl": { "$type": "fontSizes", "$value": "24" },
    "3xl": { "$type": "fontSizes", "$value": "30" },
    "4xl": { "$type": "fontSizes", "$value": "36" }
  },
  "fontWeight": {
    "light": { "$type": "fontWeights", "$value": "300" },
    "regular": { "$type": "fontWeights", "$value": "400" },
    "medium": { "$type": "fontWeights", "$value": "500" },
    "semibold": { "$type": "fontWeights", "$value": "600" },
    "bold": { "$type": "fontWeights", "$value": "700" }
  },
  "shadow": {
    "sm": {
      "$type": "boxShadow",
      "$value": { "color": "{color.overlay.shadow-10}", "type": "dropShadow", "x": "0", "y": "1", "blur": "2", "spread": "0" }
    },
    "md": {
      "$type": "boxShadow",
      "$value": { "color": "{color.overlay.shadow-15}", "type": "dropShadow", "x": "0", "y": "4", "blur": "12", "spread": "0" }
    }
  }
}
