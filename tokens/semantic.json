{
  "text": {
    "primary": { "$type": "color", "$value": "{color.grey.900}" },
    "secondary": { "$type": "color", "$value": "{color.grey.500}" },
    "inverse": { "$type": "color", "$value": "{color.white}" },
    "brand": { "$type": "color", "$value": "{color.brand.500}" },
    "disabled": { "$type": "color", "$value": "{color.overlay.ink-40}" }
  },
  "surface": {
    "default": { "$type": "color", "$value": "{color.white}" },
    "subtle": { "$type": "color", "$value": "{color.grey.50}" },
    "secondary": { "$type": "color", "$value": "{color.grey.100}" },
    "muted": { "$type": "color", "$value": "{color.grey.400}" },
    "border": { "$type": "color", "$value": "{color.grey.200}" },
    "selected": { "$type": "color", "$value": "{color.tint.brand}" },
    "disabled": { "$type": "color", "$value": "{color.overlay.muted-40}" }
  },
  "action": {
    "primary": { "$type": "color", "$value": "{color.brand.500}" },
    "primary-hover": { "$type": "color", "$value": "{color.brand.600}" },
    "secondary": { "$type": "color", "$value": "{color.white}" },
    "secondary-hover": { "$type": "color", "$value": "{color.tint.brand}" },
    "theme": { "$type": "color", "$value": "{color.brand.800}" }
  },
  "feedback": {
    "success": { "$type": "color", "$value": "{color.success.500}" },
    "warning": { "$type": "color", "$value": "{color.warning.500}" },
    "danger": { "$type": "color", "$value": "{color.danger.500}" }
  },
  "typography": {
    "heading-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontWeight": "{fontWeight.bold}",
        "fontSize": "{fontSize.3xl}",
        "lineHeight": "36px"
      }
    },
    "heading-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontWeight": "{fontWeight.semibold}",
        "fontSize": "{fontSize.xl}",
        "lineHeight": "24px"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontWeight": "{fontWeight.regular}",
        "fontSize": "{fontSize.base}",
        "lineHeight": "24px"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontWeight": "{fontWeight.medium}",
        "fontSize": "{fontSize.xs}",
        "lineHeight": "18px"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontWeight": "{fontWeight.semibold}",
        "fontSize": "{fontSize.xs}",
        "lineHeight": "18px"
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontWeight": "{fontWeight.medium}",
        "fontSize": "{fontSize.sm}",
        "lineHeight": "20px"
      }
    }
  },
  "elevation": {
    "resting": { "$type": "boxShadow", "$value": "{shadow.sm}" },
    "raised": { "$type": "boxShadow", "$value": "{shadow.md}" }
  }
}
