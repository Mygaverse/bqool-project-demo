{
  "button": {
    "primary": {
      "bg": { "$type": "color", "$value": "{action.primary}" },
      "bg-hover": { "$type": "color", "$value": "{action.primary-hover}" },
      "fg": { "$type": "color", "$value": "{text.inverse}" },
      "radius": { "$type": "borderRadius", "$value": "{radius.md}" },
      "bg-disabled": { "$type": "color", "$value": "{surface.disabled}" },
      "fg-disabled": { "$type": "color", "$value": "{text.disabled}" }
    },
    "secondary": {
      "bg": { "$type": "color", "$value": "{surface.default}" },
      "bg-hover": { "$type": "color", "$value": "{action.primary}" },
      "fg": { "$type": "color", "$value": "{text.primary}" },
      "fg-hover": { "$type": "color", "$value": "{text.inverse}" },
      "border": { "$type": "color", "$value": "{surface.border}" },
      "border-hover": { "$type": "color", "$value": "{action.primary}" },
      "bg-disabled": { "$type": "color", "$value": "{surface.disabled}" },
      "fg-disabled": { "$type": "color", "$value": "{text.disabled}" }
    }
  },
  "badge": {
    "outline": {
      "neutral": {
        "bg": { "$type": "color", "$value": "{surface.default}" },
        "border": { "$type": "color", "$value": "{surface.border}" },
        "fg": { "$type": "color", "$value": "{text.secondary}" }
      },
      "success": {
        "bg": { "$type": "color", "$value": "{surface.default}" },
        "border": { "$type": "color", "$value": "{feedback.success}" },
        "fg": { "$type": "color", "$value": "{feedback.success}" }
      },
      "warning": {
        "bg": { "$type": "color", "$value": "{surface.default}" },
        "border": { "$type": "color", "$value": "{feedback.warning}" },
        "fg": { "$type": "color", "$value": "{feedback.warning}" }
      },
      "danger": {
        "bg": { "$type": "color", "$value": "{surface.default}" },
        "border": { "$type": "color", "$value": "{feedback.danger}" },
        "fg": { "$type": "color", "$value": "{feedback.danger}" }
      }
    },
    "solid": {
      "neutral": {
        "bg": { "$type": "color", "$value": "{text.secondary}" },
        "fg": { "$type": "color", "$value": "{text.inverse}" }
      },
      "success": {
        "bg": { "$type": "color", "$value": "{color.overlay.success-20}" },
        "fg": { "$type": "color", "$value": "{feedback.success}" }
      },
      "warning": {
        "bg": { "$type": "color", "$value": "{color.overlay.warning-20}" },
        "fg": { "$type": "color", "$value": "{feedback.warning}" }
      },
      "danger": {
        "bg": { "$type": "color", "$value": "{color.overlay.danger-20}" },
        "fg": { "$type": "color", "$value": "{feedback.danger}" }
      }
    }
  },
  "toggle": {
    "track-on": { "$type": "color", "$value": "{action.primary}" },
    "track-off": { "$type": "color", "$value": "{surface.border}" },
    "knob": { "$type": "color", "$value": "{color.white}" }
  },
  "card": {
    "bg": { "$type": "color", "$value": "{surface.default}" },
    "border": { "$type": "color", "$value": "{surface.border}" },
    "radius": { "$type": "borderRadius", "$value": "{radius.lg}" },
    "shadow": { "$type": "boxShadow", "$value": "{elevation.resting}" },
    "selected": {
      "bg": { "$type": "color", "$value": "{surface.selected}" },
      "border": { "$type": "color", "$value": "{action.primary}" }
    }
  },
  "trendPill": {
    "positive": {
      "bg": { "$type": "color", "$value": "{color.overlay.success-20}" },
      "fg": { "$type": "color", "$value": "{feedback.success}" }
    },
    "negative": {
      "bg": { "$type": "color", "$value": "{color.overlay.danger-20}" },
      "fg": { "$type": "color", "$value": "{feedback.danger}" }
    }
  },
  "deliveryStatus": {
    "delivering": { "$type": "color", "$value": "{feedback.success}" },
    "limited": { "$type": "color", "$value": "{feedback.warning}" },
    "not-delivering": { "$type": "color", "$value": "{feedback.danger}" }
  },
  "statusPill": {
    "enabled": {
      "bg": { "$type": "color", "$value": "{action.primary}" },
      "fg": { "$type": "color", "$value": "{text.inverse}" }
    },
    "paused": {
      "bg": { "$type": "color", "$value": "{surface.muted}" },
      "fg": { "$type": "color", "$value": "{text.inverse}" }
    },
    "pending": {
      "bg": { "$type": "color", "$value": "{surface.default}" },
      "fg": { "$type": "color", "$value": "{action.primary}" },
      "border": { "$type": "color", "$value": "{action.primary}" }
    }
  }
}
